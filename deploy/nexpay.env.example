# Copy to /opt/nexpay/nexpay.env on the VM and fill in real values.
# Read by the systemd units (EnvironmentFile).

# Shared HMAC secret for signing + validating JWTs.
# The gateway AND user-service must use the SAME value.
# Must be at least 32 characters (HS256 needs a 256-bit key).
# Generate one with:  openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# Optional: cap the heap per service. NOT needed on Oracle A1 (24 GB),
# but useful on a 1 GB micro VM where 6 services must share memory.
# JAVA_TOOL_OPTIONS=-Xmx256m
